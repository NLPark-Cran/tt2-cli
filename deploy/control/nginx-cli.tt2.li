server {
    server_name cli.tt2.li;
    client_max_body_size 60M;

    # CLI 与安装脚本（静态）
    location = /tt2 {
        alias /opt/tt2/tt2-cli/cli/tt2;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }
    location = /install.sh {
        alias /opt/tt2/tt2-cli/cli/install.sh;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }
    location = /edge-bootstrap.sh {
        alias /opt/tt2/tt2-cli/deploy/edge/bootstrap.sh;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }

    # 控制面 API
    location /api/ {
        proxy_pass http://127.0.0.1:8902;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 60M;
    }

    location / {
        return 302 https://free.hub.tt2.li;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/cli.tt2.li/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cli.tt2.li/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = cli.tt2.li) {
        return 301 https://$host$request_uri;
    }
    server_name cli.tt2.li;
    listen 80;
    return 404;
}
