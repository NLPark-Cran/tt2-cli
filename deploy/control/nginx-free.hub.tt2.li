server {
    server_name free.hub.tt2.li;
    root /var/www/free.hub.tt2.li;
    index index.html;
    client_max_body_size 5M;

    # 控制台与 OAuth 回调走同源 API（cookie 会话）
    location /api/ {
        proxy_pass http://127.0.0.1:8902;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 60M;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js)$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/cli.tt2.li/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cli.tt2.li/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = free.hub.tt2.li) {
        return 301 https://$host$request_uri;
    }
    server_name free.hub.tt2.li;
    listen 80;
    return 404;
}
