---
// 页脚：ASCII 分隔线 + 链接
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-700/60">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <pre
      class="mb-8 hidden select-none overflow-hidden text-center font-mono text-[10px] leading-tight text-ink-600 sm:block"
      aria-hidden="true">──[ tt2-cli ]──────────[ lhub.tt2.li ]──────────[ cran-code lite ]──</pre>
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="font-mono text-sm text-zinc-300">
          tt2<span class="text-brand-500">-cli</span>
          <span class="text-ink-500"> · </span>
          <span class="text-zinc-500">让 Agent 一句话上线你的产品</span>
        </p>
        <p class="mt-1 text-xs text-zinc-600">© {year} lhub.tt2.li · 猹询码驱动的静态托管网络</p>
      </div>
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-zinc-500">
        <a href="/docs/" class="transition-colors hover:text-brand-300">文档</a>
        <a href="/docs/policy/" class="transition-colors hover:text-brand-300">内容政策</a>
        <a href="mailto:abuse@tt2.li" class="transition-colors hover:text-brand-300">滥用举报</a>
        <a
          href="https://github.com/NLPark-Cran/tt2-cli"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-brand-300">GitHub</a
        >
        <a
          href="https://watcha.cn"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-brand-300">观猹</a
        >
      </nav>
    </div>
  </div>
</footer>
