---
// 顶部导航：Logo + 文档 / 控制台入口
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/docs/', label: '文档' },
  { href: '/console/', label: '控制台' },
];
---

<header class="sticky top-0 z-50 border-b border-ink-700/60 bg-ink-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-md border border-brand-500/40 bg-brand-500/10 font-mono text-sm font-semibold text-brand-400"
        >$_</span
      >
      <span class="font-mono text-base font-semibold tracking-tight text-brand-50">
        tt2<span class="text-brand-500">-cli</span>
      </span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      {
        links.map((l) => {
          const active = l.href === '/' ? path === '/' : path.startsWith(l.href);
          return (
            <a
              href={l.href}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition-colors',
                active
                  ? 'bg-brand-500/10 text-brand-300'
                  : 'text-zinc-400 hover:bg-ink-800 hover:text-zinc-100',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
      <a
        href="https://github.com/NLPark-Cran/tt2-cli"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 hidden items-center gap-1.5 rounded-md border border-ink-600 px-3 py-1.5 font-mono text-xs text-zinc-400 transition-colors hover:border-brand-500/50 hover:text-brand-300 sm:flex"
      >
        <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-current" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
    </nav>
  </div>
</header>
