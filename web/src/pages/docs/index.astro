import DocsLayout from '../../layouts/DocsLayout.astro';

const cards = [
  {
    href: '/docs/quickstart/',
    title: '快速上手',
    desc: '3 分钟完成：安装 CLI → tt2 login → tt2 push，让你的第一个站点上线。',
  },
  {
    href: '/docs/cli/',
    title: 'CLI 命令参考',
    desc: 'login / push / sites / domain 等全部命令的完整参数说明与 --json 模式。',
  },
  {
    href: '/docs/domain/',
    title: '自备域名指南',
    desc: '把自有域名 CNAME 到 lhub，附阿里云 / DNSPod / Cloudflare 填写示例。',
  },
  {
    href: '/docs/standards/',
    title: '推送标准',
    desc: '产物要求、50MB 限制、文件类型白名单，以及猹询码会做的自动修补。',
  },
  {
    href: '/docs/policy/',
